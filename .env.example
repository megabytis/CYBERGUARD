# CYBERGUARD Configuration Template

# Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=127.0.0.1

# Security
SECRET_KEY=change_me_to_a_cryptographically_secure_random_key_min_32_chars
SESSION_EXPIRE_HOURS=24
COOKIE_SECURE=false

# Controlled Demo Account (Never committed or displayed in UI)
DEMO_ADMIN_EMAIL=analyst@cyberguard.internal
DEMO_ADMIN_PASSWORD=CyberGuard2026!SecOps
DEMO_ADMIN_NAME=Chief Security Analyst
DEMO_ADMIN_ORG=Cyber Defense Center

# Storage
DATABASE_URL=sqlite:///./data/cyberguard.db

# DeepSeek AI (Primary Fast LLM - deepseek-chat / Flash)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Groq Cloud AI (Alternative Fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Scoring Weights
HEURISTIC_WEIGHT=0.70
ML_WEIGHT=0.30
